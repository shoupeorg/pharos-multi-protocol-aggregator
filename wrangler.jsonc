{
  "name": "pharos-multi-protocol-aggregator",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pharos-multi-protocol-aggregator", "database_id": "37a72fcf-16e4-46ce-ba97-0a9082d37191", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
